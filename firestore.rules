rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: author
    // Document ID: profile
    // Fields:
    //   - photoUrl: string (required) - Base64 or URL of the photo
    //   - updatedAt: timestamp (optional) - Last update time
    //
    // Collection: books
    // Document ID: {bookId}
    // Fields:
    //   - coverUrl: string (required) - Base64 or URL of the book cover
    //   - updatedAt: timestamp (optional) - Last update time
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "miguemora100@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidAuthor(data) {
      return data.keys().hasAll(['photoUrl']) &&
             data.photoUrl is string &&
             data.photoUrl.size() < 1048576; // Limit to 1MB
    }

    function isValidBook(data) {
      return data.keys().hasAll(['coverUrl']) &&
             data.coverUrl is string &&
             data.coverUrl.size() < 1048576 && // Limit to 1MB
             (!('spineColor' in data) || (data.spineColor is string && data.spineColor.size() < 10));
    }

    match /author/profile {
      // Anyone can read the author profile
      allow read: if true;
      
      // Only the admin can update the author profile
      allow write: if isAdmin() && isValidAuthor(request.resource.data);
    }

    match /books {
      allow read: if true;
      match /{bookId} {
        allow read: if true;
        allow create, update: if isAdmin() && isValidBook(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
  }
}
