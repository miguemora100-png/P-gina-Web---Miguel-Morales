rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: author
    // Document ID: profile
    // Fields:
    //   - photoUrl: string (required) - Base64 or URL of the photo
    //   - updatedAt: timestamp (optional) - Last update time
    //
    // Collection: books
    // Document ID: {bookId}
    // Fields:
    //   - coverUrl: string (required) - Base64 or URL of the book cover
    //   - updatedAt: timestamp (optional) - Last update time
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "miguemora100@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidAuthor(data) {
      return (data.keys().hasAny(['photoUrl', 'publisherSealUrl'])) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() < 1000000)) &&
             (!('publisherSealUrl' in data) || (data.publisherSealUrl is string && data.publisherSealUrl.size() < 1000000));
    }

    function isValidBook(data) {
      return (data.keys().hasAny(['coverUrl', 'coverUrlEn'])) &&
             (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() < 1000000)) && // Limit to ~1MB
             (!('coverUrlEn' in data) || (data.coverUrlEn is string && data.coverUrlEn.size() < 1000000)) && // Limit to ~1MB
             (!('spineColor' in data) || (data.spineColor is string && data.spineColor.size() < 10)) &&
             (!('spineColorEn' in data) || (data.spineColorEn is string && data.spineColorEn.size() < 10));
    }

    function isValidMessage(data) {
      return (data.keys().hasAll(['name', 'email', 'message'])) &&
             (data.name is string && data.name.size() > 0 && data.name.size() <= 100) &&
             (data.email is string && data.email.size() > 3 && data.email.size() <= 150) &&
             (data.message is string && data.message.size() > 0 && data.message.size() <= 5000);
    }

    function isValidSubscriber(data) {
      return (data.keys().hasAll(['email'])) &&
             (data.email is string && data.email.size() > 3 && data.email.size() <= 150);
    }

    function isValidVisit(data) {
      return (data.keys().hasAll(['visitorId', 'language', 'device'])) &&
             (data.visitorId is string && data.visitorId.size() > 0 && data.visitorId.size() <= 100) &&
             (data.language is string && data.language.size() >= 2 && data.language.size() <= 10) &&
             (data.device is string && data.device.size() > 0 && data.device.size() <= 30) &&
             (!('browser' in data) || (data.browser is string && data.browser.size() <= 100)) &&
             (!('os' in data) || (data.os is string && data.os.size() <= 100)) &&
             (!('referrer' in data) || (data.referrer is string && data.referrer.size() <= 300)) &&
             (!('path' in data) || (data.path is string && data.path.size() <= 150)) &&
             (!('timestamp' in data) || data.timestamp is timestamp);
    }

    match /author/profile {
      // Anyone can read the author profile
      allow read: if true;
      
      // Only the admin can update the author profile
      allow write: if isAdmin() && isValidAuthor(request.resource.data);
    }

    match /books {
      allow read: if true;
      match /{bookId} {
        allow read: if true;
        allow create, update: if isAdmin() && isValidBook(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    match /messages/{messageId} {
      allow create: if isValidMessage(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow create: if isValidSubscriber(request.resource.data);
      allow read, delete: if isAdmin();
    }

    match /visits/{visitId} {
      // Anyone can log an anonymous visit
      allow create: if isValidVisit(request.resource.data);
      // ONLY the verified admin (author) can read, update, or delete visits
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
  }
}
