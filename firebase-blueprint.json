{
  "entities": {
    "author": {
      "title": "Author Profile",
      "description": "Stores author-related information like the profile photo.",
      "type": "object",
      "properties": {
        "photoUrl": {
          "type": "string",
          "description": "Base64 encoded string or URL of the author's photo."
        },
        "publisherSealUrl": {
          "type": "string",
          "description": "Base64 encoded string or URL of the publisher's seal."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["photoUrl"]
    },
    "book": {
      "title": "Book Cover",
      "description": "Stores a book's cover image URL and theme color.",
      "type": "object",
      "properties": {
        "coverUrl": {
          "type": "string",
          "description": "Base64 encoded string or URL of the book's cover."
        },
        "spineColor": {
          "type": "string",
          "description": "Hex color code for the book's spine and back cover."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["coverUrl"]
    },
    "message": {
      "title": "Contact Message",
      "description": "Stores contact messages submitted by website visitors.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Sender name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender email address."
        },
        "message": {
          "type": "string",
          "description": "Content of the message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp."
        },
        "read": {
          "type": "boolean",
          "description": "Whether the message has been read by admin."
        }
      },
      "required": ["name", "email", "message"]
    },
    "subscriber": {
      "title": "Newsletter Subscriber",
      "description": "Stores newsletter subscription emails.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Subscriber email address."
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Subscription timestamp."
        }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/author/profile": {
      "schema": "author",
      "description": "Single document storing the author's profile data."
    },
    "/books/{bookId}": {
      "schema": "book",
      "description": "Stores cover images for each book."
    },
    "/messages/{messageId}": {
      "schema": "message",
      "description": "Contact messages from readers and visitors."
    },
    "/subscribers/{subscriberId}": {
      "schema": "subscriber",
      "description": "Newsletter email subscribers list."
    }
  }
}
